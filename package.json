{
  "name": "laplace",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered PR description generator - Chrome extension & VS Code extension",
  "type": "module",
  "workspaces": [
    "packages/*",
    "landing-page"
  ],
  "scripts": {
    "build": "npm run build -w @laplace/shared -w @laplace/chrome-ext",
    "build:shared": "npm run build -w @laplace/shared",
    "build:chrome": "npm run build -w @laplace/chrome-ext",
    "build:vscode": "npm run build -w @laplace/vscode-ext",
    "dev:chrome": "npm run dev -w @laplace/chrome-ext",
    "dev:vscode": "npm run dev -w @laplace/vscode-ext",
    "dev:landing": "npm run dev -w landing-page",
    "lint": "npm run lint -w @laplace/chrome-ext",
    "typecheck": "npm run typecheck -w @laplace/shared && npm run typecheck -w @laplace/chrome-ext && npm run typecheck -w @laplace/vscode-ext"
  }
}
